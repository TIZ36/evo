{
  "name": "@tiz36/evo",
  "version": "0.3.0",
  "description": "Provider-neutral evolving memory service and Cordis plugin for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "license": "MIT",
  "author": "TIZ36",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TIZ36/evo.git"
  },
  "bugs": {
    "url": "https://github.com/TIZ36/evo/issues"
  },
  "homepage": "https://github.com/TIZ36/evo#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis": {
      "types": "./dist/cordis/index.d.mts",
      "default": "./dist/cordis/index.mjs"
    },
    "./deepseek": {
      "types": "./dist/deepseek/index.d.mts",
      "default": "./dist/deepseek/index.mjs"
    },
    "./hook": {
      "types": "./dist/hook/cli.d.mts",
      "default": "./dist/hook/cli.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/design-principles.md",
    "docs/storage-architecture.md",
    "docs/reference",
    "examples",
    "cordis.patch.yml",
    "install_evo_dsps.sh",
    "install_evo_claude.sh",
    "install_evo_codex.sh",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown && node scripts/copy-client.mjs && pnpm plugin:build",
    "rule:scan": "node scripts/iron-rule.mjs",
    "hook:drift": "node scripts/check-hook-drift.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run rule:scan && npm run hook:drift",
    "plugin:build": "tsdown -c tsdown.plugin.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0",
    "unrun": "^0.3.1",
    "vitest": "^4.0.0"
  },
  "bin": {
    "evo-hook": "./dist/hook/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
